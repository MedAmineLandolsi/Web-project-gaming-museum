DirectoryIndex view/frontoffice/index.php
RewriteEngine On
RewriteBase /projet/

# Servir directement le frontoffice index
DirectoryIndex view/frontoffice/index.php

# Redirection pour les URLs avec index.php -> pointer vers frontoffice
RewriteCond %{THE_REQUEST} /index\.php [NC]
RewriteRule ^(.*?)index\.php(?:/(.*))?$ /projet/view/frontoffice/$1$2 [L,R=301,NC]

# Gérer les URLs propres: rediriger vers le front controller situé dans view/frontoffice
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ view/frontoffice/index.php [QSA,L]

# Sécurité - empêcher l'accès direct aux fichiers sensibles
<Files ~ "\.(env|json|config.js|md|gitignore|gitattributes|lock)$">
    Order allow,deny
    Deny from all
</Files>

<Files ~ "(composer\.json|composer\.lock|package\.json|package-lock\.json)">
    Order allow,deny
    Deny from all
</Files>