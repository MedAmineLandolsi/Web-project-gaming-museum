DirectoryIndex index.php
RewriteEngine On

# Si le fichier/dossier existe, on le sert tel quel
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sinon, router vers le front controller à la racine
RewriteRule ^ index.php [QSA,L]

# Sécurité - empêcher l'accès direct aux fichiers sensibles
<Files ~ "\.(env|json|config.js|md|gitignore|gitattributes|lock)$">
    Order allow,deny
    Deny from all
</Files>

<Files ~ "(composer\.json|composer\.lock|package\.json|package-lock\.json)">
    Order allow,deny
    Deny from all
</Files>